---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search — Storyfoundry" description="Search every published story and chapter on Storyfoundry.">
  <section class="page-hero search-hero" data-pagefind-ignore>
    <p class="eyebrow">Search the archive</p>
    <h1>What are you<br /><em>looking for?</em></h1>
    <p>Search by title, character, place, or any half-remembered phrase.</p>
  </section>
  <section class="search-panel" data-pagefind-ignore>
    <label for="search-input">Search every published page</label>
    <div class="search-box"><span aria-hidden="true">⌕</span><input id="search-input" type="search" placeholder="Try “the memory of rain”" autocomplete="off" /></div>
    <p class="search-status" aria-live="polite" data-search-status>Type to begin searching.</p>
    <div class="search-results" data-search-results></div>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search-input')!;
    const results = document.querySelector<HTMLElement>('[data-search-results]')!;
    const status = document.querySelector<HTMLElement>('[data-search-status]')!;
    const base = document.documentElement.dataset.base?.replace(/\/$/, '') || '';
    let pagefind: any;
    let timer: ReturnType<typeof setTimeout>;

    input?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const query = input.value.trim();
        if (!query) {
          results.innerHTML = '';
          status.textContent = 'Type to begin searching.';
          return;
        }
        status.textContent = 'Searching…';
        try {
          pagefind ||= await import(`${base}/pagefind/pagefind.js`);
          const search = await pagefind.search(query);
          const data = await Promise.all(search.results.slice(0, 12).map((result: any) => result.data()));
          status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'} found.`;
          results.innerHTML = data.map((item) => `
            <a class="search-result" href="${item.url}">
              <span>${item.meta?.title || 'Storyfoundry'}</span>
              <p>${item.excerpt}</p>
              <small>Read this page →</small>
            </a>`).join('');
        } catch {
          status.textContent = 'Search becomes available after the site has been built.';
        }
      }, 180);
    });
  </script>
</BaseLayout>
